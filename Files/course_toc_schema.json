{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "course_toc_schema",
    "type": "object",
    "required": [
        "title",
        "description",
        "chapters"
    ],
    "properties": {
        "title": {
            "type": "string",
            "maxLength": 80
        },
        "description": {
            "type": "string",
            "maxLength": 200
        },
        "chapters": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "shortDescription",
                    "order"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "shortDescription": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "order": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}